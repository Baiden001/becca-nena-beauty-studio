# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — never expose to the browser. Used server-side for the
# order-notification email trigger and for staff invites (Team & Access page).
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend) — used to notify the boss of new orders
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
# Optional — defaults to onboarding@resend.dev, which works immediately
# with no setup. Once you verify your own domain in Resend, set this to
# something like "Becca Nena <orders@yourdomain.com>".
RESEND_FROM_EMAIL=onboarding@resend.dev

# WhatsApp business number used for CTA links (international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Your production URL (e.g. https://becca-nena.vercel.app). Used to build
# the staff-invite email's link back to the app. If unset, the app derives
# it from the incoming request instead — set this explicitly if you're
# behind a proxy/custom domain setup where that derivation isn't reliable.
NEXT_PUBLIC_SITE_URL=https://becca-nena.vercel.app
